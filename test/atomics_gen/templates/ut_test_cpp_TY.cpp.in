#include <vsync/atomic.hpp>
#include <iostream>
#include <atomic>
#include <cassert>
#include <vector>

_tmpl_map(MAP_VALS_u8, (VUINT8_MAX/2), VUINT8_MAX);
_tmpl_map(MAP_VALS_u16, VUINT8_MAX, VUINT16_MAX);
_tmpl_map(MAP_VALS_u32, VUINT8_MAX, VUINT16_MAX, VUINT32_MAX);
_tmpl_map(MAP_VALS_u64, VUINT8_MAX, VUINT16_MAX, VUINT32_MAX, VUINT64_MAX);
_tmpl_map(MAP_VALS_sz,  VUINT8_MAX, VUINT16_MAX, VUINT32_MAX, VSIZE_MAX);


_tmpl_begin(TY = [[u8; u16; u32; u64; sz; ptr]]);

std::vector<TT> g_values = {0, MAP_VALS_TY};

void
assert_match(vsync::atomic<TT> &var, std::atomic<TT> &mirror)
{
    TT v_var        = var.load();
    TT v_mirror     = mirror.load();
    if (v_var != v_mirror) {
        std::cerr << "[assert_match] vsync::atomic " << v_var << " =? std::atomic " << v_mirror << std::endl;
    }
    assert(v_var == v_mirror);
}

void
test_init(void)
{
    for (TT val : g_values) {
        std::atomic<TT> mirror(val);
        vsync::atomic<TT> var(val);
        assert_match(var, mirror);
    }
}

void
test_store(void)
{
    std::atomic<TT> mirror(0);
    vsync::atomic<TT> var(0);

    for (int order = vsync::memory_order_relaxed;
         order <= vsync::memory_order_seq_cst; order++) {
        for (TT val : g_values) {
            mirror.store(val, static_cast<std::memory_order>(order));
            var.store(val, static_cast<vsync::memory_order>(order));
            assert_match(var, mirror);
        }
    }
}

void
test_exchange(void)
{
    std::atomic<TT> mirror(0);
    vsync::atomic<TT> var(0);
    TT r_var = 0;
    TT r_mirror = 0;

    for (int order = vsync::memory_order_relaxed;
         order <= vsync::memory_order_seq_cst; order++) {
        for (TT val : g_values) {
            r_mirror = mirror.exchange(val, static_cast<std::memory_order>(order));
            r_var = var.exchange(val, static_cast<vsync::memory_order>(order));
            assert_match(var, mirror);
            assert(r_mirror == r_var);
        }
    }
}

void
test_compare_exchange(void)
{
    std::atomic<TT> mirror(0);
    vsync::atomic<TT> var(0);

    bool r_var = false;
    bool r_mirror = false;

    TT v_var = 0;
    TT v_mirror = 0;

    const vsize_t repeat = 3;

    for (int order = vsync::memory_order_relaxed;
         order <= vsync::memory_order_seq_cst; order++) {

        for (TT val : g_values) {
            v_var = v_mirror = val;
            for(vsize_t i = 0; i < repeat; i++) {
                r_mirror = mirror.compare_exchange_strong(v_var, static_cast<std::memory_order>(order), static_cast<std::memory_order>(order));
                r_var = var.compare_exchange_strong(v_mirror, static_cast<vsync::memory_order>(order), static_cast<vsync::memory_order>(order));
                assert(r_mirror == r_var);
                assert(v_var == v_mirror);
            }
        }

        for (TT val : g_values) {
            v_var = v_mirror = val;
            for(vsize_t i = 0; i < repeat; i++) {
                r_mirror = mirror.compare_exchange_weak(v_var, static_cast<std::memory_order>(order), static_cast<std::memory_order>(order));
                r_var = var.compare_exchange_weak(v_mirror, static_cast<vsync::memory_order>(order), static_cast<vsync::memory_order>(order));
                assert_match(var, mirror);
                assert(r_mirror == r_var);
                assert(v_var == v_mirror);
            }
        }
    }
}

_tmpl_end;

int main(void) {
    test_init();
    test_store();
    test_exchange();
    test_compare_exchange();
    return 0;
}
