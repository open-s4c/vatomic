#ifndef __ATOMIC_HPP__
#define __ATOMIC_HPP__
_tmpl_begin(=);
AUTOGEN
_tmpl_end;

#include <vsync/atomic.h>
#define _tmpl_mute
#include <vsync/atomic/tmplr.h>
#define _tmpl_unmute

namespace vsync
{

typedef enum memory_order {
    memory_order_relaxed,
    memory_order_consume,
    memory_order_acquire,
    memory_order_release,
    memory_order_acq_rel,
    memory_order_seq_cst
} memory_order;

template <typename T> struct atomic;

_tmpl_begin(TY = [[u8; u16; u32; u64; sz]]);

template <> struct atomic<TT> {
    TT load(memory_order order = memory_order_seq_cst) const noexcept
    {
        switch (order) {
            case memory_order_consume:
            case memory_order_acquire:
                return __vatomic_read_acq(&_v);
            case memory_order_relaxed:
                return __vatomic_read_rlx(&_v);
            case memory_order_release:
            case memory_order_acq_rel:
            // TODO: warn about it
            case memory_order_seq_cst:
            default:
                return __vatomic_read(&_v);
        }
    }
    void store(TT v, memory_order order = memory_order_seq_cst) noexcept
    {
        switch (order) {
            case memory_order_release:
                __vatomic_write_rel(&_v, v);
                break;
            case memory_order_relaxed:
                __vatomic_write_rlx(&_v, v);
                break;
            case memory_order_acquire:
            case memory_order_acq_rel:
            case memory_order_consume:
            // TODO: warn about it
            case memory_order_seq_cst:
            default:
                return __vatomic_write(&_v, v);
        }
    }

    atomic()
    {
        __vatomic_init(&_v, 0);
    }
    atomic(TT v)
    {
        __vatomic_init(&_v, v);
    }

    atomic(const atomic &)                     = delete;
    atomic &operator=(const atomic &)          = delete;
    atomic &operator=(const atomic &) volatile = delete;

    TT operator=(TT v) noexcept
    {
        store(v);
        return v;
    }

    operator TT() const noexcept
    {
        return load();
    }

    TT exchange(TT v,
                       memory_order order = memory_order_seq_cst) noexcept
    {
        switch (order) {
            case memory_order_release:
                return __vatomic_xchg_rel(&_v, v);
            case memory_order_relaxed:
                return __vatomic_xchg_rlx(&_v, v);
            case memory_order_consume:
            case memory_order_acquire:
                return __vatomic_xchg_acq(&_v, v);
            case memory_order_acq_rel:
            case memory_order_seq_cst:
            default:
                return __vatomic_xchg(&_v, v);
        }
    }

    TT compare_exchange_strong(
        TT &expected, TT desired,
        memory_order order   = memory_order_seq_cst,
        memory_order failure = memory_order_seq_cst) noexcept
    {
        TT old = 0;
        switch (order) {
            case memory_order_release:
                old = __vatomic_cmpxchg_rel(&_v, expected, desired);
                break;
            case memory_order_relaxed:
                old = __vatomic_cmpxchg_rlx(&_v, expected, desired);
                break;
            case memory_order_consume:
            case memory_order_acquire:
                old = __vatomic_cmpxchg_acq(&_v, expected, desired);
                break;
            case memory_order_acq_rel:
            case memory_order_seq_cst:
            default:
                old = __vatomic_cmpxchg(&_v, expected, desired);
                break;
        }
        if (old == expected) {
            return true;
        } else {
            expected = old;
            return false;
        }
    }

    TT
    compare_exchange_weak(TT &expected, TT desired,
                          memory_order order   = memory_order_seq_cst,
                          memory_order failure = memory_order_seq_cst) noexcept
    {
        return compare_exchange_strong(expected, desired, order, failure);
    }


    TT fetch_add(TT v,
                        memory_order order = memory_order_seq_cst) noexcept
    {
        switch (order) {
            case memory_order_release:
                return __vatomic_get_add_rel(&_v, v);
            case memory_order_relaxed:
                return __vatomic_get_add_rlx(&_v, v);
            case memory_order_consume:
            case memory_order_acquire:
                return __vatomic_get_add_acq(&_v, v);
            case memory_order_acq_rel:
            case memory_order_seq_cst:
            default:
                return __vatomic_get_add(&_v, v);
        }
    }


    TT operator+=(TT v) noexcept
    {
        return fetch_add(v);
    }

    TT operator++(int) noexcept
    {
        return __vatomic_get_inc(&_v);
    }

    TT operator++() noexcept
    {
        return __vatomic_inc_get(&_v);
    }

    TT fetch_sub(TT v,
                        memory_order order = memory_order_seq_cst) noexcept
    {
        switch (order) {
            case memory_order_release:
                return __vatomic_get_sub_rel(&_v, v);
            case memory_order_relaxed:
                return __vatomic_get_sub_rlx(&_v, v);
            case memory_order_consume:
            case memory_order_acquire:
                return __vatomic_get_sub_acq(&_v, v);
            case memory_order_acq_rel:
            case memory_order_seq_cst:
            default:
                return __vatomic_get_sub(&_v, v);
        }
    }

    TT operator-=(TT v) noexcept
    {
        return fetch_sub(v);
    }

    TT operator--(int) noexcept
    {
        return __vatomic_get_dec(&_v);
    }

    TT operator--() noexcept
    {
        return __vatomic_dec_get(&_v);
    }

    TT fetch_and(TT v,
                        memory_order order = memory_order_seq_cst) noexcept
    {
        switch (order) {
            case memory_order_release:
                return __vatomic_get_and_rel(&_v, v);
            case memory_order_relaxed:
                return __vatomic_get_and_rlx(&_v, v);
            case memory_order_consume:
            case memory_order_acquire:
                return __vatomic_get_and_acq(&_v, v);
            case memory_order_acq_rel:
            case memory_order_seq_cst:
            default:
                return __vatomic_get_and(&_v, v);
        }
    }

    TT operator&=(TT v) noexcept
    {
        return fetch_and(v);
    }

    TT fetch_or(TT v,
                       memory_order order = memory_order_seq_cst) noexcept
    {
        switch (order) {
            case memory_order_release:
                return __vatomic_get_or_rel(&_v, v);
            case memory_order_relaxed:
                return __vatomic_get_or_rlx(&_v, v);
            case memory_order_consume:
            case memory_order_acquire:
                return __vatomic_get_or_acq(&_v, v);
            case memory_order_acq_rel:
            case memory_order_seq_cst:
            default:
                return __vatomic_get_or(&_v, v);
        }
    }

    TT operator|=(TT v) noexcept
    {
        return fetch_or(v);
    }

    TT fetch_xor(TT v,
                        memory_order order = memory_order_seq_cst) noexcept
    {
        switch (order) {
            case memory_order_release:
                return __vatomic_get_xor_rel(&_v, v);
            case memory_order_relaxed:
                return __vatomic_get_xor_rlx(&_v, v);
            case memory_order_consume:
            case memory_order_acquire:
                return __vatomic_get_xor_acq(&_v, v);
            case memory_order_acq_rel:
            case memory_order_seq_cst:
            default:
                return __vatomic_get_xor(&_v, v);
        }
    }

    TT operator^=(TT v) noexcept
    {
        return fetch_xor(v);
    }


    bool is_lock_free() const noexcept
    {
        return true;
    }

  private:
    AA _v;
};
_tmpl_end;
};

#endif /* VATOMIC_BUILTINS_H */
